---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wizard from '../components/pages/Wizard';
import { createBreadcrumbSchema, createSoftwareApplicationSchema } from '../lib/seo';

const title = 'Personalised Solar Assessment | Solarpedia';
const description = 'Get a personalised estimate of your solar potential, potential savings and payback period.';
const keywords = 'solar savings calculator UK, solar assessment UK, solar cost calculator UK, solar ROI calculator UK, commercial solar calculator';

const schema = [
  createSoftwareApplicationSchema({
    name: 'Solarpedia Personalised Solar Assessment',
    description: 'Get a personalised estimate of your solar potential, potential savings and payback period.',
    path: '/wizard',
  }),
  createBreadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Personalised Solar Assessment', path: '/wizard' },
  ]),
];
---

<BaseLayout 
  title={title}
  description={description}
  keywords={keywords}
  schema={schema}
  canonical="https://solarpedia.co.uk/wizard"
>
  <Wizard client:only="react" />
</BaseLayout>
